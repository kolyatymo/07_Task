<Window x:Class="_07_task.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_07_task"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Button FontSize="20" Background="Aqua" Width="200" Height="50" Margin="40" DockPanel.Dock="Top" Click="Button_Gmail">Gmail</Button>
        <Button FontSize="20" Background="Aqua" Width="200" Height="50" Margin="40" DockPanel.Dock="Top" Click="Button_ukr_net">ukr.net</Button>
        <Button FontSize="20" Background="Aqua" Width="200" Height="50" Margin="40" DockPanel.Dock="Top" Click="Button_iCloud">iCloud</Button>
    </DockPanel>
</Window>
