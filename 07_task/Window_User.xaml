<Window x:Class="_07_task.Window_User"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_07_task"
        mc:Ignorable="d"
        Title="Window_User" Height="450" Width="800">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="10" FontSize="20" x:Name="UserLogin">login</TextBlock>
        <Button Width="100" Height="40" FontSize="13" Background="GreenYellow" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="5" Click="Button_Download_gmail">Download gmail</Button>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>
            <ListBox SelectionChanged="ListMessage_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" x:Name="ListMessage"></ListBox>
            <TextBlock x:Name="InfoUserMessage" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Column="1"></TextBlock>
        </Grid>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Button Margin="10" FontSize="15" Click="Button_Delete">Delete Message</Button>
            <Button Margin="10" FontSize="15" Grid.Column="1" Click="Button_Sort">Sort</Button>
            <Button Margin="10" FontSize="15" Grid.Column="2" Click="Button_Filtr">Add to cart</Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Margin="5" FontSize="20">Write a response</TextBlock>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label>Write Message</Label>
            <TextBox x:Name="AnswerText" VerticalContentAlignment="Center" Grid.Column="1"></TextBox>
        </Grid>
        <Button DockPanel.Dock="Top" Height="40" Width="100" Margin="10" Click="Button_Answer">Answer</Button>
    </DockPanel>
</Window>
